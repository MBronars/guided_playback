"""Style 2: rendered frames of a run's guided rollout and its simulator replay, in ONE pyrender scene for every
simulator (the pickup kitchen: wood table top, wall photo, floor; the same table for all domains). Runs in the
foundationpose env over EGL (PYOPENGL_PLATFORM=egl); no torch.

Per case (member, variant): a one-row gif [generated | simulated], the same camera in both panels, bodies drawn as
meshes placed by a per-frame Kabsch fit of the contract point clouds to their frame-0 shape:
  pickup / rl_push : Franka hand + finger visual meshes (URDF), object = convex hull of its frame-0 particles
                     (exactly the body Isaac simulated); pool link segments 241 / 212 / 218 rows.
  mould            : paddle = box of the recorded pusher size (frame-0 rows are axis-aligned), dough = one sphere per particle.
  pushing          : cube = 50 mm box at the recorded frame-0 yaw, rod = cylinder r 10 mm over the rod rows' z range.
The table top sits at the lowest object particle of frame 0.
"""
import io, json, os, zipfile, xml.etree.ElementTree as ET
import imageio, numpy as np, trimesh
from PIL import Image
if not hasattr(np, "infty"):
    np.infty = np.inf
import pyrender
from ..replay.common import qmat, kabsch, VARIANT_KEY
from .arm import Arm, ARM_LINKS, base_pose, grasp_offset

AD = "/data/user_data/mbronars/packages/IsaacLabEnvs/assets/franka_gripper"
BG = "/data/group_data/katefgroup-ssd/sim_scene_gen/background"
POOL = "/data/user_data/mbronars/packages/pickup_replay_isaac/out/pool_pick_val/specs.npz"
Y_UP_TO_LINK = trimesh.transformations.rotation_matrix(np.pi / 2, [1, 0, 0])
LINK_ORDER = ("panda_hand", "panda_leftfinger", "panda_rightfinger")
WALL = {"pickup": "kitchen__kitchen_orig0", "rl_push": "kitchen__kitchen_orig0", "mould": "kitchen__kitchen_orig0", "pushing": "working_room_orig0"}
TABLE = {"mould": (0.50, 0.50)}
SCALE = {"pushing": 2.0, "mould": 3.0}                             # render-only magnification of the scene (positions + tool sizes) so the tools are not toy-sized next to the Franka                                    # table top size per domain (default 1.30 x 1.40)
COL_ACT, COL_OBJ = [70, 120, 200, 255], [220, 110, 60, 255]


def rpy(r, p_, y):
    return trimesh.transformations.euler_matrix(r, p_, y, "sxyz")


def _urdf_visuals():
    urdf = ET.parse(os.path.join(AD, "robots/franka_gripper.urdf")).getroot(); visuals = {}
    for link in urdf.findall("link"):
        for v in link.findall("visual"):
            m = v.find("geometry/mesh")
            if m is None:
                continue
            o = v.find("origin")
            off = rpy(*[float(s) for s in (o.get("rpy", "0 0 0") if o is not None else "0 0 0").split()])
            off[:3, 3] = [float(s) for s in (o.get("xyz", "0 0 0") if o is not None else "0 0 0").split()]
            obj = os.path.join(AD, os.path.splitext(m.get("filename").replace("package://", ""))[0] + ".obj")
            visuals.setdefault(link.get("name"), []).append((obj, off))
    return visuals


_cache = {}
def link_meshes(obj):
    if obj not in _cache:
        out = []
        for g in trimesh.load(obj, force="scene").geometry.values():
            g = g.copy(); g.apply_transform(Y_UP_TO_LINK); out.append(pyrender.Mesh.from_trimesh(g, smooth=False))
        _cache[obj] = out
    return _cache[obj]


def material_texture(name):
    d = os.path.join(BG, "tables/usd/textures", name)
    if os.path.isdir(d):
        return Image.open(os.path.join(d, f"{name}_Color.jpg")).convert("RGB")
    with zipfile.ZipFile(os.path.join(BG, "tables/texture_raw_new_0514", name + ".zip")) as z:
        return Image.open(io.BytesIO(z.read(next(n for n in z.namelist() if n.endswith("_Color.jpg"))))).convert("RGB")


def plane(corners, image, repeat=(1, 1)):
    v = np.array(corners, dtype=np.float64)
    uv = np.array([[0, 0], [repeat[0], 0], [repeat[0], repeat[1]], [0, repeat[1]]], dtype=np.float64)
    m = trimesh.Trimesh(vertices=v, faces=np.array([[0, 1, 2], [0, 2, 3], [0, 2, 1], [0, 3, 2]]), process=False)
    mat = trimesh.visual.material.PBRMaterial(baseColorTexture=image, metallicFactor=0.0, roughnessFactor=0.95)
    m.visual = trimesh.visual.TextureVisuals(uv=uv, material=mat)
    return pyrender.Mesh.from_trimesh(m, smooth=False)


def look_at(eye, target, up=(0, 0, 1)):
    f = np.asarray(target, float) - eye; f /= np.linalg.norm(f)
    s = np.cross(f, up); s /= np.linalg.norm(s); u = np.cross(s, f)
    M = np.eye(4); M[:3, 0], M[:3, 1], M[:3, 2], M[:3, 3] = s, u, -f, eye
    return M


def solid(mesh, rgba):
    mesh.visual = trimesh.visual.ColorVisuals(mesh, face_colors=rgba); return pyrender.Mesh.from_trimesh(mesh, smooth=False)


def pose44(R, t):
    M = np.eye(4); M[:3, :3], M[:3, 3] = R, t; return M


class Body:
    """A rendered body: a node (or nodes) plus the frame-0 point rows it is fitted to each frame."""
    def __init__(self, rows, nodes, M0=np.eye(4)):
        self.rows, self.nodes, self.M0 = rows, nodes, M0            # nodes: [(node, offset)]; M0: mesh pose at frame 0

    def place(self, scene, P0, Pf):
        R, t = kabsch(P0[self.rows].astype(np.float64), Pf[self.rows].astype(np.float64))
        M = pose44(R, t) @ self.M0
        for node, off in self.nodes:
            scene.set_pose(node, M @ off)
        return M


def build_scene(domain, top, focus_pts, W, H, wall_img, upper_img, counter_frac, wood_img, floor_img, table_centre=None, big=False):
    TX, TY = (1.30, 1.40) if big else TABLE.get(domain, (1.30, 1.40))
    scene = pyrender.Scene(bg_color=[1, 1, 1, 0], ambient_light=[0.42, 0.42, 0.42])
    floor_z = top - 0.74
    cx, cy = float(focus_pts[:, 0].mean()), float(focus_pts[:, 1].mean())
    if table_centre is not None: cx, cy = float(table_centre[0]), float(table_centre[1])
    scene.add(plane([[cx - 2.6, cy - 2.6, floor_z], [cx + 2.8, cy - 2.6, floor_z], [cx + 2.8, cy + 2.6, floor_z], [cx - 2.6, cy + 2.6, floor_z]], floor_img, (7, 7)))
    wy, wtop = cy + 1.35, floor_z + 3.4; ph = 0.90 / counter_frac; ptop = floor_z + ph
    scene.add(plane([[cx - 3.0, wy, floor_z], [cx + 4.0, wy, floor_z], [cx + 4.0, wy, ptop], [cx - 3.0, wy, ptop]], wall_img, (7.0 / ph, 1)))
    scene.add(plane([[cx - 3.0, wy, ptop], [cx + 4.0, wy, ptop], [cx + 4.0, wy, wtop], [cx - 3.0, wy, wtop]], upper_img, (1, 1)))
    wx = cx - 1.5
    scene.add(plane([[wx, wy, floor_z], [wx, cy - 3.0, floor_z], [wx, cy - 3.0, ptop], [wx, wy, ptop]], wall_img, (4.35 / ph, 1)))
    scene.add(plane([[wx, wy, ptop], [wx, cy - 3.0, ptop], [wx, cy - 3.0, wtop], [wx, wy, wtop]], upper_img, (1, 1)))
    tx0, tx1, ty0, ty1 = cx - TX / 2, cx + TX / 2, cy - TY / 2, cy + TY / 2
    slab = trimesh.creation.box((TX, TY, 0.045)); tp = np.eye(4); tp[:3, 3] = [cx, cy, top - 0.0235]
    scene.add(solid(slab, [188, 168, 140, 255]), pose=tp)
    scene.add(plane([[tx0, ty0, top + 0.0008], [tx1, ty0, top + 0.0008], [tx1, ty1, top + 0.0008], [tx0, ty1, top + 0.0008]], wood_img, (2 * TX / 1.3, 2 * TY / 1.4)))   # just above the slab: no z-fight
    for lx, ly in ((tx0 + 0.06, ty0 + 0.06), (tx1 - 0.06, ty0 + 0.06), (tx0 + 0.06, ty1 - 0.06), (tx1 - 0.06, ty1 - 0.06)):
        leg = trimesh.creation.box((0.07, 0.07, top - 0.045 - floor_z)); lp = np.eye(4); lp[:3, 3] = [lx, ly, (top - 0.045 + floor_z) / 2]
        scene.add(solid(leg, [150, 126, 96, 255]), pose=lp)
    return scene


def add_bodies(scene, domain, P0, roles, obj_mask, z, m, sc=1.0):
    """Create the domain's meshes at frame 0; return the Body list."""
    bodies = []
    if domain in ("pickup", "rl_push"):
        pool = np.load(POOL); counts = [int(c) for c in pool["link_counts"][0]]; visuals = _urdf_visuals()
        off = 0
        for li, name in enumerate(LINK_ORDER):
            rows = np.zeros(len(roles), bool); rows[off:off + counts[li]] = True; off += counts[li]
            loc = pool["link_local"][0, li, :counts[li]].astype(np.float64)
            R, t = kabsch(loc, P0[rows].astype(np.float64))                      # link frame at frame 0
            nodes = [(scene.add(mm), o) for obj, o in visuals.get(name, []) for mm in link_meshes(obj)]
            bodies.append(Body(rows, nodes, pose44(R, t)))
        hull = trimesh.convex.convex_hull(P0[obj_mask].astype(np.float64))
        bodies.append(Body(obj_mask, [(scene.add(solid(hull, COL_OBJ)), np.eye(4))]))
    elif domain == "mould":
        pad = roles == 0; c = P0[pad].mean(0); size = tuple(np.ptp(P0[pad], 0) + 0.0)
        box = trimesh.creation.box(size); b = Body(pad, [(scene.add(solid(box, COL_ACT)), np.eye(4))], pose44(np.eye(3), c)); b.tool_half = size[2] / 2; b.tool_thickness = size[1]; bodies.append(b)
        sph = trimesh.creation.icosphere(subdivisions=1, radius=0.0016 * sc); sph.visual = trimesh.visual.ColorVisuals(sph, face_colors=COL_OBJ)
        n = int(obj_mask.sum()); poses = np.repeat(np.eye(4)[None], n, 0); poses[:, :3, 3] = P0[obj_mask]
        node = scene.add(pyrender.Mesh.from_trimesh(sph, poses=poses, smooth=False))
        bodies.append(["dough", node, obj_mask, sph])
    elif domain == "pushing":
        cube = obj_mask; rod = roles == 0
        ridx = int(np.nonzero(z["pose_action_mask"][m] == False)[0][0]); R0 = z["body_poses0"][m, ridx, :3, :3]
        box = trimesh.creation.box((0.05 * sc, 0.05 * sc, 0.05 * sc)); bodies.append(Body(cube, [(scene.add(solid(box, COL_OBJ)), np.eye(4))], pose44(R0, P0[cube].mean(0))))
        zr = P0[rod][:, 2]; cyl = trimesh.creation.cylinder(radius=0.01 * sc, height=float(zr.max() - zr.min()))
        c = P0[rod].mean(0); b = Body(rod, [(scene.add(solid(cyl, COL_ACT)), np.eye(4))], pose44(np.eye(3), c)); b.tool_half = float(zr.max() - zr.min()) / 2; b.tool_thickness = 0.02 * sc; bodies.append(b)
    return bodies


def place(scene, bodies, P0, Pf):
    poses = []
    for b in bodies:
        if isinstance(b, Body):
            poses.append(b.place(scene, P0, Pf))
        else:                                                                    # dough: one sphere per particle, moved to Pf
            # pyrender uploads instance poses to the GPU only once per mesh, so setting prim.poses later is silently ignored:
            # rebuild the instanced mesh every frame (the renderer frees the old one's buffers).
            _, node, mask, sph = b; sp = np.repeat(np.eye(4)[None], int(mask.sum()), 0); sp[:, :3, 3] = Pf[mask]
            scene.remove_node(node); b[1] = scene.add(pyrender.Mesh.from_trimesh(sph, poses=sp, smooth=False))
    return poses


def render_run(run, sim, out, variants=("guided",), size=(480, 360), fps=10, max_frames=40, wood="Wood010_1K-JPG", arm=False, scale=None,
               rot180=False, keyframes=False, members=None, camera_from=None):
    """rot180: rotate the whole scene (generated, simulated, target) 180 deg about the vertical axis through the object's frame-0
    centroid -- a rigid transform, so the robot base ends up on the other side of the object. keyframes: one PNG of the SIMULATED
    replay, [frame 0 | last frame], the last frame with the object-centroid trace."""
    z = np.load(os.path.join(run, "rollout.npz")); rj = json.load(open(os.path.join(run, "result.json"))); domain = rj["domain"]
    S = np.load(os.path.join(run, f"replay_{sim}{os.environ.get('GP_REPLAY_SUFFIX', '')}", "replay.npz")); sim_variants = json.loads(str(S["variants"]))   # GP_REPLAY_SUFFIX=_yawfix: read a corrected replay
    os.makedirs(out, exist_ok=True); W, H = size
    wall_img = Image.open(os.path.join(BG, "walls/textures", WALL.get(domain, "kitchen__kitchen_orig0") + "_tex.png")).convert("RGB")
    _wa = np.asarray(wall_img.convert("L"), dtype=float).mean(1)
    counter_frac = 1.0 - float(np.argmax(np.abs(np.diff(_wa))) + 1) / len(_wa)      # counter edge, as a fraction up the photo (render_rollout_scene.py)
    upper_img = Image.new("RGB", (8, 8), tuple(np.asarray(wall_img).reshape(-1, 3)[:wall_img.size[0] * 40].mean(0).astype(int)))
    wood_img = material_texture(wood); floor_img = material_texture("Wood048_1K-JPG")
    renderer = pyrender.OffscreenRenderer(W, H); written = []
    B, T = z["predicted"].shape[:2]
    sc = float(SCALE.get(domain, 1.0) if scale is None else scale)
    for m in range(B):
        if members is not None and m not in members: continue
        for var in variants:
            P = z[VARIANT_KEY[var]][m] * sc; Q = S["sim"][sim_variants.index(var), m] * sc; roles = z["roles"][m]; obj = z["object_mask"][m]
            target = z["target"][m] * sc
            if rot180:
                c0 = P[0, obj].mean(0); flip = lambda X: np.concatenate([2 * c0[:2] - X[..., :2], X[..., 2:]], -1)
                P, Q, target = flip(P), flip(Q), flip(target)
            top = 0.0 if domain in ("mould", "pushing") else float(P[0, obj][:, 2].min())   # MPM ground / PushBoundary table = z 0; pickup objects rest at their lowest particle
            if rj.get("task") == "place": top = float(rj.get("table_z", 0.0115)) * sc          # held start: the object is in the air at frame 0; the table is the dataset table
            pts = np.concatenate([P[:, roles >= 0].reshape(-1, 3), Q[:, roles >= 0].reshape(-1, 3), target[None]])
            if camera_from is not None:                                              # frame the scene like another run (shared camera across methods)
                zc = np.load(os.path.join(camera_from, 'rollout.npz')); Sc = np.load(os.path.join(camera_from, f'replay_{sim}', 'replay.npz'))
                Pc = zc['predicted'][m] * sc; Qc = Sc['sim'][0, m] * sc; rc = zc['roles'][m]
                pts = np.concatenate([Pc[:, rc >= 0].reshape(-1, 3), Qc[:, rc >= 0].reshape(-1, 3), (zc['target'][m] * sc)[None]])
            cam_dir = np.array([0.50, -0.80, 0.34]) / np.linalg.norm([0.50, -0.80, 0.34]); away = -cam_dir[:2] / np.linalg.norm(cam_dir[:2])
            centre = (pts.min(0) + pts.max(0)) / 2
            if arm and domain in ("pickup", "rl_push"):
                Tb = base_pose(domain, centre, top, away); table_centre = Tb[:3, 3] + np.array([0.42, 0.0, 0.0])          # the kitchen recipe: slab centred 0.42 m in front of the base
            elif arm:
                tool_pts = np.concatenate([P[:, roles == 0].mean(1), Q[:, roles == 0].mean(1)])                 # tool centre per frame, both panels
                reach_proj = float(((tool_pts[:, :2] - centre[:2]) @ (-away)).max())
                Tb = base_pose(domain, centre, top, away, reach_proj=reach_proj); table_centre = (centre[:2] + Tb[:3, 3][:2]) / 2
            else:
                Tb = None; table_centre = None
            scene = build_scene(domain, top, pts, W, H, wall_img, upper_img, counter_frac, wood_img, floor_img, table_centre=table_centre, big=arm)
            bodies = add_bodies(scene, domain, P[0], roles, obj, z, m, sc)
            arm_nodes, hand_nodes, ARM, q_prev, track = [], [], None, None, [0.0, 0.0]
            if arm:
                ARM = Arm(); visuals = _urdf_visuals()
                for li, name in enumerate(ARM_LINKS):
                    for objp, o in visuals.get(name, []):
                        for mm in link_meshes(objp): arm_nodes.append((li, scene.add(mm), o))
                if domain not in ("pickup", "rl_push"):                                             # hand + fingers holding the tool
                    for name in ("panda_hand", "panda_leftfinger", "panda_rightfinger"):
                        for objp, o in visuals.get(name, []):
                            for mm in link_meshes(objp): hand_nodes.append((name, scene.add(mm), o))
            tgt = trimesh.creation.icosphere(subdivisions=2, radius=0.008 * max(1.0, sc ** 0.5)); tp = np.eye(4); tp[:3, 3] = target
            scene.add(solid(tgt, [30, 170, 120, 255]), pose=tp)
            lo, hi = pts.min(0), pts.max(0); focus = (lo + hi) / 2; focus[2] = max(focus[2], top + 0.04); span = max(float((hi - lo).max()), 0.12)
            if domain == "mould" and not os.environ.get("GP_FRAME_ALL"):             # frame the dough + goal, not the paddle's whole travel (GP_FRAME_ALL=1: include it)
                po = np.concatenate([P[:, obj].reshape(-1, 3), Q[:, obj].reshape(-1, 3), target[None]]); lo, hi = po.min(0), po.max(0)
                focus = (lo + hi) / 2; focus[2] = top + 0.02; span = max(float((hi - lo)[:2].max()), 0.12)
                eye = focus + (0.30 + 1.2 * span) * np.array([0.50, -0.80, 0.30]) / np.linalg.norm([0.50, -0.80, 0.30])
            else:
                eye = focus + (0.32 + 1.5 * span) * np.array([0.50, -0.80, 0.34]) / np.linalg.norm([0.50, -0.80, 0.34])
            if arm:                                                                  # pull back and up so the arm is in frame
                focus = focus + 0.35 * (Tb[:3, 3] - focus) * np.array([1, 1, 0]) + np.array([0, 0, 0.08])
                eye = focus + (0.75 + 1.4 * span) * np.array([0.50, -0.80, 0.42]) / np.linalg.norm([0.50, -0.80, 0.42])
            cam = look_at(eye, focus)
            scene.add(pyrender.PerspectiveCamera(yfov=np.pi / 4.5, aspectRatio=W / H), pose=cam)
            scene.add(pyrender.DirectionalLight(intensity=3.2), pose=cam)
            scene.add(pyrender.DirectionalLight(intensity=2.0), pose=look_at(focus + np.array([-0.5, -0.8, 1.9]), focus))
            idx = np.unique(np.linspace(0, T - 1, min(T, max_frames)).round().astype(int)); frames = []
            if keyframes: idx = np.array([0, T - 1])
            for f in idx:
                row = []
                for Pf in ((Q[f],) if keyframes else (P[f], Q[f])):
                    poses = place(scene, bodies, P[0], Pf)
                    if ARM is not None:
                        if domain in ("pickup", "rl_push"):
                            T_h = poses[0]                                                           # the fitted panda_hand frame
                        else:
                            tool = [b for b in bodies if isinstance(b, Body) and hasattr(b, "tool_half")][0]
                            T_tool = poses[[b for b in bodies if isinstance(b, Body)].index(tool)]
                            # two equivalent grasps (hand yawed 180 deg about the approach axis): keep the one the arm reaches better
                            cands = [T_tool @ grasp_offset(domain, tool.tool_half) @ trimesh.transformations.rotation_matrix(a, [0, 0, 1]) for a in (0.0, np.pi)]
                            sols = []
                            for Tc in cands:
                                Tl = np.linalg.inv(Tb) @ Tc
                                qq, ep, er = (ARM.solve_first(Tl) if q_prev is None else ARM.ik(q_prev, Tl))
                                if q_prev is not None and (ep > 0.005 or er > 0.09):
                                    q2, ep2, er2 = ARM.solve_first(Tl)
                                    if ep2 + 0.1 * er2 < ep + 0.1 * er: qq, ep, er = q2, ep2, er2
                                sols.append((ep + 0.1 * er, qq, ep, er, Tc))
                            _, q_prev, ep, er, T_h = min(sols, key=lambda t: t[0])
                            L, Rr = ARM.finger_poses(T_h, tool.tool_thickness / 2)
                            for name, node, o in hand_nodes:
                                scene.set_pose(node, {"panda_hand": T_h, "panda_leftfinger": L, "panda_rightfinger": Rr}[name] @ o)
                        if domain in ("pickup", "rl_push"):
                            T_local = np.linalg.inv(Tb) @ T_h
                            if q_prev is None: q_prev, ep, er = ARM.solve_first(T_local)
                            else:
                                q_prev, ep, er = ARM.ik(q_prev, T_local)
                                if ep > 0.005 or er > 0.09:
                                    q2, ep2, er2 = ARM.solve_first(T_local)
                                    if ep2 + 0.1 * er2 < ep + 0.1 * er: q_prev, ep, er = q2, ep2, er2
                        track[0] = max(track[0], ep * 1e3); track[1] = max(track[1], np.degrees(er))
                        links, _ = ARM.fk(q_prev)
                        for li, node, o in arm_nodes: scene.set_pose(node, Tb @ links[li] @ o)
                    rgba, _ = renderer.render(scene, flags=pyrender.RenderFlags.RGBA | pyrender.RenderFlags.SHADOWS_DIRECTIONAL)
                    al = rgba[..., 3:4].astype(np.float32) / 255.0; row.append((rgba[..., :3] * al + 255 * (1 - al)).astype(np.uint8))
                if keyframes and f == T - 1:                                        # object-centroid trace of the simulated replay, drawn on top
                    from PIL import ImageDraw
                    Pm = pyrender.PerspectiveCamera(yfov=np.pi / 4.5, aspectRatio=W / H).get_projection_matrix(W, H); Vi = np.linalg.inv(cam)
                    def px(p):
                        c = Pm @ (Vi @ np.append(p, 1.0)); n = c[:3] / c[3]; return ((n[0] + 1) / 2 * W, (1 - n[1]) / 2 * H)
                    cpath = [px(p) for p in Q[:, obj].mean(1)]; im = Image.fromarray(row[0]); dr = ImageDraw.Draw(im)
                    dr.line(cpath, fill=(214, 40, 130), width=4, joint="curve")
                    for (x, y), col in ((cpath[0], (214, 40, 130)), (cpath[-1], (214, 40, 130))): dr.ellipse([x - 6, y - 6, x + 6, y + 6], fill=col, outline=(255, 255, 255), width=2)
                    tx, ty = px(target); dr.ellipse([tx - 9, ty - 9, tx + 9, ty + 9], outline=(20, 160, 110), width=3)
                    row[0] = np.asarray(im)
                frames.append(row[0] if keyframes else np.concatenate([row[0], np.full((H, 6, 3), 255, np.uint8), row[1]], 1))
            name = f"m{m}_{var}"; gif = os.path.join(out, name + ".gif")
            if keyframes:
                png = os.path.join(out, name + "_keyframes.png"); imageio.imwrite(png, np.concatenate([frames[0], np.full((H, 6, 3), 255, np.uint8), frames[1]], 1))
                print(f"[render] keyframes -> {png}", flush=True); written.append(dict(member=m, variant=var, keyframes=png)); continue
            imageio.mimsave(gif, frames, duration=1.0 / fps, loop=0); imageio.imwrite(os.path.join(out, name + ".png"), frames[len(frames) // 2])
            written.append(dict(member=m, variant=var, gif=gif, frames=int(len(idx)), size=[2 * W + 6, H], arm=bool(arm), scale=sc, arm_track_mm_max=round(track[0], 2), arm_track_deg_max=round(track[1], 2)))
            print(f"[render] {domain} {os.path.basename(run)} {name}: {len(idx)} frames -> {gif} ({os.path.getsize(gif) / 1e6:.1f} MB)" + (f"  arm tracks the hand to {track[0]:.1f} mm / {track[1]:.1f} deg" if arm else ""), flush=True)
    renderer.delete()
    json.dump(dict(sim=sim, variants=list(variants), cases=written, arm=bool(arm), scale=sc, layout="left = generated rollout, right = simulator replay; same camera"), open(os.path.join(out, "renders.json"), "w"), indent=1)
    return written
